# Reviewed example only. Install on the HTTPS host after explicit deployment approval.
# Export ONLY index.html, admin.html, kitchen.html and settings/ into this document root.
# Never make the source checkout, .git, backend/ or waf/ a public document root.
server {
    listen 80;
    server_name chillibek.online www.chillibek.online;
    return 308 https://chillibek.online$request_uri;
}

server {
    listen 443 ssl;
    server_name chillibek.online www.chillibek.online;
    ssl_certificate /etc/letsencrypt/live/chillibek.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chillibek.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/chillibek-public;
    index index.html;
    # An infrastructure safety limit, independent of the configurable 1 MiB WAF rule.
    client_max_body_size 16m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /settings { return 308 /settings/; }
    location /settings/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
    location ~ ^/(waf-api(?:/|$)|dashboard(?:/|$)|api(?:/|$)|health$) {
        # Preserve the full path. Auth and settings endpoints terminate on the WAF,
        # while restaurant /api requests pass through its existing upstream proxy.
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Overwrite client-supplied forwarding data; do not append untrusted IPs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ =404; }
}
