FLASK_DEBUG=false
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_SECRET_KEY=
DATABASE_PATH=instance/chillibek.sqlite3
# For PostgreSQL deployment, prefer DATABASE_URL and leave DATABASE_PATH unused.
# Example format only; keep real credentials outside Git:
# DATABASE_URL=postgresql+psycopg://chillibek:<password>@postgres:5432/chillibek
CORS_ALLOWED_ORIGINS=https://chillibek.online,https://www.chillibek.online,http://127.0.0.1:5500
RATELIMIT_STORAGE_URI=memory://
